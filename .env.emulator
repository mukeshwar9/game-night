# Loaded by Vite only for `--mode emulator` (`npm run dev:emu`, Playwright's
# web server). Committed on purpose: nothing here is secret. It points the app
# at the local Firebase Auth + Realtime Database emulators under a `demo-`
# project, which the emulators treat as offline-only, so this mode can never
# read or write the live game-night project even if .env.local exists.
#
# Every VITE_FIREBASE_* key is set so none of them falls through to .env.local.
VITE_USE_EMULATORS=1
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=localhost
# The database emulator loads database.rules.json into the
# `<projectId>-default-rtdb` namespace (see firebase.json), so the app must
# use that namespace for the repository's rules to apply.
VITE_FIREBASE_DATABASE_URL=http://127.0.0.1:9000/?ns=demo-game-night-default-rtdb
VITE_FIREBASE_PROJECT_ID=demo-game-night
VITE_FIREBASE_STORAGE_BUCKET=demo-game-night.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
