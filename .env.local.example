# Copy to .env.local and fill in your own Firebase web-app config
# (Firebase console → Project settings → Your apps → SDK setup and config).
#
# .env.local  → `npm run dev` / `npm run build` talk to that REAL project.
#               Anything you do in the app writes to its live database.
# .env.emulator (committed) → `npm run dev:emu` runs against the local Auth +
#               Realtime Database emulators (start them with `npm run
#               emulators`). Disposable data, no credentials needed — prefer
#               it for local testing.
#
# .env.local is gitignored (*.local); never commit real values here.
VITE_FIREBASE_API_KEY="your-api-key"
VITE_FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
VITE_FIREBASE_DATABASE_URL="https://your-project-id-default-rtdb.firebaseio.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-project-id.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="your-sender-id"
VITE_FIREBASE_APP_ID="your-app-id"

# Optional ----------------------------------------------------------------
# App Check (reCAPTCHA Enterprise site key). Leave empty to skip App Check.
# In local dev against a real project, set a debug token registered in the
# Firebase console (App Check → Apps → Manage debug tokens).
VITE_APPCHECK_SITE_KEY=""
VITE_APPCHECK_DEBUG_TOKEN=""
# TURN for WebRTC games (comma-separated URLs). Without it only public STUN is
# used and ~5–10% of peers behind symmetric NATs can't connect; with it,
# public rooms relay so strangers never see each other's IP.
VITE_TURN_URLS=""
VITE_TURN_USERNAME=""
VITE_TURN_CREDENTIAL=""
