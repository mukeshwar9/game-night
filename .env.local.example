# Copy to .env.local and fill in your own Firebase web-app config
# (Firebase console → Project settings → Your apps → SDK setup and config).
#
# .env.local  → `npm run dev` / `npm run build` talk to that REAL project.
#               Anything you do in the app writes to its live database.
# .env.emulator (committed) → `npm run dev:emu` runs against the local Auth +
#               Realtime Database emulators (start them with `npm run
#               emulators`). Disposable data, no credentials needed — prefer
#               it for local testing.
#
# .env.local is gitignored (*.local); never commit real values here.
VITE_FIREBASE_API_KEY="your-api-key"
VITE_FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
VITE_FIREBASE_DATABASE_URL="https://your-project-id-default-rtdb.firebaseio.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-project-id.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="your-sender-id"
VITE_FIREBASE_APP_ID="your-app-id"
# Web Push certificate public key (Firebase console → Project settings →
# Cloud Messaging → Web Push certificates → Generate key pair). Required for
# push notifications; empty = push toggle hidden/disabled.
VITE_FIREBASE_VAPID_KEY=""
# Invite push is sent by the sendInvitePush Cloud Function; no client setting.

# Optional ----------------------------------------------------------------
# App Check (reCAPTCHA Enterprise site key). Leave empty to skip App Check.
# In local dev against a real project, set a debug token registered in the
# Firebase console (App Check → Apps → Manage debug tokens).
VITE_APPCHECK_SITE_KEY=""
VITE_APPCHECK_DEBUG_TOKEN=""
# Run Google sign-in's redirect on the serving Hosting domain (fixes sign-in in
# an installed iOS PWA). Set to 1 only after adding
# https://<project>.web.app/__/auth/handler to the OAuth web client's authorised
# redirect URIs (Google Cloud → APIs & Services → Credentials).
VITE_AUTH_SAME_ORIGIN=""
# TURN for WebRTC games (comma-separated URLs). Without it only public STUN is
# used and ~5–10% of peers behind symmetric NATs can't connect; with it,
# public rooms relay so strangers never see each other's IP.
VITE_TURN_URLS=""
VITE_TURN_USERNAME=""
VITE_TURN_CREDENTIAL=""
# Paddle.js on the default payment link (the page a Paddle checkout link opens with
# ?_ptxn=<transaction id>). The client-side token comes from Paddle → Developer tools
# → Authentication (test_… in the sandbox, live_… in production). VITE_PADDLE_ENV is
# "sandbox" (default) or "production"; a token from the other environment is refused.
VITE_PADDLE_CLIENT_TOKEN=""
VITE_PADDLE_ENV="sandbox"

# Party voice chat (Cloudflare Realtime SFU via the voiceSfu Cloud Function).
# 1 shows the voice controls in party rooms. The function also needs
# VOICE_ENABLED=1 and its Cloudflare secrets (functions/.env.example).
VITE_VOICE_ENABLED=""

# Store listings, once the apps are live (src/lib/storeLinks.js): the numeric
# App Store id turns on Safari's Smart App Banner, the iPhone "get the app"
# link and the update screen's store button; VITE_PLAY_LIVE="1" turns on the
# Android one. Leave empty until the listings exist.
VITE_APPSTORE_ID=""
VITE_PLAY_LIVE=""

# Monitoring (docs/ANALYTICS.md). Each is off, and its code never loads, while
# the value is empty. Do Not Track and the in-app SHARE USAGE DATA switch turn
# both off for that visitor.
# Sentry errors + native crashes: project DSN (Sentry -> Project Settings ->
# Client Keys). It is a public identifier, safe in the bundle.
VITE_SENTRY_DSN=""
# PostHog journeys + session replay: project API key (PostHog -> Project
# settings, starts with phc_) and the ingest host of your region:
# https://us.i.posthog.com (default) or https://eu.i.posthog.com
VITE_POSTHOG_KEY=""
VITE_POSTHOG_HOST=""
# Source-map upload (npm run sourcemaps:sentry) reads SENTRY_AUTH_TOKEN,
# SENTRY_ORG and SENTRY_PROJECT from the shell. Do NOT put the auth token in a
# VITE_ variable: those are baked into the public bundle.
