# Copy to functions/.env (git-ignored) for local runs, or set as deploy-time params.
# Payments use Paddle's SANDBOX unless PADDLE_ENV=production. Placeholders only.
# Launch switch: billing refuses everything unless this is 1 (client mirror: VITE_MONETIZATION_ENABLED=1).
MONETIZATION_ENABLED=
PADDLE_ENV=sandbox
# JSON map of product id -> Paddle price id (created in the Paddle dashboard).
# Product ids are the keys of PRODUCTS in src/lib/premiumCatalog.js.
PADDLE_PRICES={"pass-monthly":"pri_REPLACE","pass-yearly":"pri_REPLACE","supporter":"pri_REPLACE","pack-themes-seasonal":"pri_REPLACE","pack-themes-arcade":"pri_REPLACE","pack-avatars-royal":"pri_REPLACE","pack-avatars-party":"pri_REPLACE","pack-avatars-dragon":"pri_REPLACE","pack-emotes-pixel":"pri_REPLACE"}
# Comma-separated verified Google emails that unlock every premium item in production.
ADMIN_EMAILS=
# Secrets (not in this file): firebase functions:secrets:set PADDLE_API_KEY  and  PADDLE_WEBHOOK_SECRET
# 1 binds those secrets on deploy (needs Secret Manager). Unset, payments answer payments-not-configured.
PAYMENTS_SECRETS=

# Razorpay (Indian buyers, INR). The key id is public and lives here; the key secret and
# webhook secret are secrets bound by the same PAYMENTS_SECRETS=1 switch:
#   firebase functions:secrets:set RAZORPAY_KEY_SECRET  and  RAZORPAY_WEBHOOK_SECRET
# Without them the Razorpay endpoints answer 503. Test-mode keys start rzp_test_;
# live keys (rzp_live_) are refused unless RAZORPAY_ENV=production.
RAZORPAY_ENV=test
RAZORPAY_KEY_ID=

# Party voice chat through the Cloudflare Realtime SFU (voice.js). Off unless VOICE_ENABLED=1.
# The Cloudflare app id and secret are secrets, bound when VOICE_SECRETS=1 (needs Secret Manager):
#   firebase functions:secrets:set CF_SFU_APP_ID  and  CF_SFU_APP_SECRET
# Optional TURN for networks that block UDP, bound when VOICE_TURN=1 as well:
#   firebase functions:secrets:set CF_TURN_KEY_ID  and  CF_TURN_TOKEN
# Unset, voiceSfu answers voice-not-configured. Client switch: VITE_VOICE_ENABLED=1.
VOICE_ENABLED=
VOICE_SECRETS=
VOICE_TURN=

# Chat moderation and report triage with TypeSafe Jev (chatModeration.js). Off until a key exists:
# without one, moderateChatMessage only prunes chat logs and triageReport does nothing.
# Production: firebase functions:secrets:set TYPESAFE_API_KEY, then TYPESAFE_SECRETS=1 binds it on deploy.
# Emulator only: a plain key here works too (never commit it).
TYPESAFE_SECRETS=
TYPESAFE_API_KEY=
