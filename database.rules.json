              },
              "number": {
                ".validate": "((newData.parent().parent().parent().parent().child('gameType').val() !== 'codewords') || (newData.isNumber() && newData.val() >= 0 && newData.val() <= 9))"
              }
            }
          },
          "guessesLeft": {
            ".validate": "((newData.parent().parent().child('gameType').val() !== 'codewords') || (newData.isNumber() && newData.val() >= 0 && newData.val() <= 25))"
          },
          "guessesMade": {
            ".validate": "((newData.parent().parent().child('gameType').val() !== 'codewords') || (newData.isNumber() && newData.val() >= 0 && newData.val() <= 25))"
          },
          "nonce": {
            ".validate": "newData.isString() && newData.val().length <= 32"
          },
          "wins": {
            "$uid": {
              ".validate": "((newData.parent().parent().parent().child('gameType').val() !== 'codewords') || (newData.isNumber() && newData.val() >= 0 && newData.val() <= 999))"
            }
          },
          "sealed": {
            "$uid": {
              ".validate": "newData.hasChildren(['epk','iv','ct','kid'])",
              "epk": {
                ".validate": "newData.isString() && newData.val().length <= 200"
              },
              "iv": {
                ".validate": "newData.isString() && newData.val().length <= 32"
              },
              "ct": {
                ".validate": "newData.isString() && newData.val().length <= 4000"
              },
              "kid": {
                ".validate": "newData.isString() && newData.val().length <= 64"
              },
              "$other": {
                ".validate": "false"
              }
            }
          },
          "clues": {
            "$uid": {
              ".validate": "((newData.parent().parent().parent().child('gameType').val() !== 'justone') || ((newData.child('h').isString() && newData.child('h').val().matches(/^[0-9a-f]{64}$/) && data.exists() ? newData.child('h').val() === data.child('h').val() : $uid === auth.uid)))"
            }
          },
          "enc": {
            "$uid": {
              ".validate": "((newData.parent().parent().parent().child('gameType').val() !== 'justone') || ((newData.hasChildren(['iv','ct']) && newData.child('iv').isString() && newData.child('iv').val().length <= 32 && newData.child('ct').isString() && newData.child('ct').val().length <= 200 && data.exists() ? (newData.child('iv').val() === data.child('iv').val() && newData.child('ct').val() === data.child('ct').val()) : $uid === auth.uid)))"
            }
          },
          "wordCommit": {
            ".validate": "((newData.parent().parent().child('gameType').val() !== 'justone') || ((newData.isString() && newData.val().matches(/^[0-9a-f]{64}$/) && (!data.exists() || newData.val() === data.val() || newData.parent().child('card').val() !== data.parent().child('card').val()))))"
          },
          "guess": {
            ".validate": "((newData.parent().parent().child('gameType').val() !== 'justone') || ((newData.child('text').isString() && newData.child('text').val().length <= 40 && (data.exists() || auth.uid === data.parent().child('guesser').val()))))"
          },
          "survivors": {
            "$uid": {
              ".validate": "((newData.parent().parent().parent().child('gameType').val() !== 'justone') || (newData.isString() && newData.val().length <= 24))"
            }
          },
          "cancelledCount": {
            ".validate": "((newData.parent().parent().child('gameType').val() !== 'justone') || (newData.isNumber() && newData.val() >= 0 && newData.val() <= 8))"
          },
          "card": {
            ".validate": "((newData.parent().parent().child('gameType').val() !== 'justone') || (newData.isNumber() && newData.val() >= 0 && newData.val() <= 13))"
          },
          "played": {
            ".validate": "((newData.parent().parent().child('gameType').val() !== 'justone') || (newData.isNumber() && newData.val() >= 0 && newData.val() <= 13))"
          },
          "score": {
            ".validate": "((newData.parent().parent().child('gameType').val() !== 'justone') || (newData.isNumber() && newData.val() >= 0 && newData.val() <= 13))"
          },
          "answers": {
            "$uid": {
              ".validate": "((newData.parent().parent().parent().child('gameType').val() !== 'herd') || (((newData.isString() && newData.val().length <= 80 || newData.child('commit').isString() && newData.child('commit').val().length <= 128) && ($uid === auth.uid || newData.val() === data.val() || newData.child('commit').val() === data.child('commit').val()))))"
            }
          },
          "reveals": {
            "$uid": {
              ".validate": "((newData.parent().parent().parent().child('gameType').val() !== 'herd') || ((newData.hasChildren(['text','salt']) && newData.child('text').isString() && newData.child('text').val().length <= 80 && newData.child('salt').isString() && newData.child('salt').val().length <= 64 && ($uid === auth.uid || newData.child('text').val() === data.child('text').val() && newData.child('salt').val() === data.child('salt').val()))))"
            }
          },
          "tally": {
            "$uid": {
              ".validate": "((newData.parent().parent().parent().child('gameType').val() !== 'herd') || (newData.isString() && newData.val().length <= 80))"
            }
          },
          "cheats": {
            "$uid": {
              ".validate": "((newData.parent().parent().parent().child('gameType').val() !== 'herd' && newData.parent().parent().parent().child('gameType').val() !== 'fibbage') || (newData.val() === true))"
            }
          },
          "cowTo": {
            ".validate": "((newData.parent().parent().child('gameType').val() !== 'herd') || (newData.isString() && newData.val().length <= 128))"
          },
          "cowMoved": {
            ".validate": "((newData.parent().parent().child('gameType').val() !== 'herd') || (newData.isBoolean()))"
          },
          "openKeys": {
            "$uid": {
              ".validate": "((newData.parent().parent().parent().child('gameType').val() !== 'spyfair' && newData.parent().parent().parent().child('gameType').val() !== 'chameleon') || ((newData.isString() && newData.val().length <= 200 && (!data.exists() || newData.val() === data.val()))))"
            }
          },
          "votes": {
            "$uid": {
              ".validate": "((newData.parent().parent().parent().child('gameType').val() !== 'spyfair' && newData.parent().parent().parent().child('gameType').val() !== 'chameleon') || ((newData.isString() && newData.val().length <= 128 && data.exists() ? newData.val() === data.val() : $uid === auth.uid)))"
            }
          },
          "order": {
            "$i": {
              ".validate": "((newData.parent().parent().parent().child('gameType').val() !== 'trivia' && newData.parent().parent().parent().child('gameType').val() !== 'fibbage') || (newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000))"
            }
          },
          "streaks": {
            "$uid": {
              ".validate": "((newData.parent().parent().parent().child('gameType').val() !== 'trivia') || (newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000))"
            }
          },
          "deltas": {
            "$uid": {
              ".validate": "((newData.parent().parent().parent().child('gameType').val() !== 'trivia' && newData.parent().parent().parent().child('gameType').val() !== 'fibbage') || (newData.isNumber() && newData.val() >= -100000 && newData.val() <= 100000))"
            }
          },
          "num": {
            ".validate": "((newData.parent().parent().child('gameType').val() !== 'fibbage') || (newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000))"
          },
          "deckSeed": {
            ".validate": "((newData.parent().parent().child('gameType').val() !== 'trivia' && newData.parent().parent().child('gameType').val() !== 'fibbage' && newData.parent().parent().child('gameType').val() !== 'herd') || ((newData.isNumber() || newData.isString() && newData.val().length <= 64)))"
          },
          "lieStartedAt": {
            ".validate": "newData.isNumber()"
          },
          "voteStartedAt": {
            ".validate": "newData.isNumber()"
          },
          "closedAt": {
            ".validate": "newData.isNumber()"
          },
          "revealDeadline": {
            ".validate": "newData.isNumber()"
          }
        }
      }
    },
    "matchmaking": {
      ".read": "auth != null",
      ".indexOn": [
        "createdAt"
      ],
      "$gameId": {
        ".write": "auth != null && ((!data.exists() && root.child('games').child($gameId).child('visibility').val() === 'public' && root.child('games').child($gameId).child('status').val() === 'waiting' && newData.child('hostUid').val() === auth.uid && (root.child('games').child($gameId).child('players').child('X').child('playerId').val() === auth.uid || root.child('games').child($gameId).child('players').child(auth.uid).child('playerId').val() === auth.uid)) || (data.exists() && data.child('hostUid').val() === auth.uid) || (!newData.exists() && (root.child('games').child($gameId).child('players').child('O').child('playerId').val() === auth.uid || root.child('games').child($gameId).child('players').child(auth.uid).child('playerId').val() === auth.uid || !root.child('games').child($gameId).exists())))",
        ".validate": "(!newData.exists() || (newData.hasChildren(['gameId','gameType','visibility','hostUid','hostName','createdAt','expiresAt']) && newData.child('gameId').val() === $gameId && newData.child('visibility').val() === 'public' && (newData.child('hostUid').val() === root.child('games').child($gameId).child('players').child('X').child('playerId').val() || root.child('games').child($gameId).child('players').child(newData.child('hostUid').val()).child('playerId').val() === newData.child('hostUid').val()) && newData.child('hostName').isString() && newData.child('hostName').val().length <= 40 && newData.child('createdAt').isNumber() && newData.child('expiresAt').isNumber()))",
        "gameType": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "hostAvatar": {
          ".validate": "newData.isString() && newData.val().length <= 200"
        },
        "hostOnline": {
          ".validate": "newData.isBoolean()"
        },
        "updatedAt": {
          ".validate": "newData.isNumber()"
        }
      }
    },
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "(auth != null && auth.uid === $uid && ((!data.child('admin').exists() && !newData.child('admin').exists()) || newData.child('admin').val() === data.child('admin').val()) && (!data.child('lastFeedbackAt').exists() || newData.child('lastFeedbackAt').exists()))",
        "displayName": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "nameLower": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "avatar": {
          ".validate": "newData.isString() && newData.val().length <= 200"
        },
        "code": {
          ".validate": "newData.isString() && newData.val().length <= 12"
        },
        "admin": {
          ".validate": "newData.isBoolean()"
        },
        "lastFeedbackAt": {
          ".validate": "newData.val() === now"
        }
      }
    },
    "profiles": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['displayName'])",
        "displayName": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40"
        },
        "nameLower": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "avatar": {
          ".validate": "newData.isString() && newData.val().length <= 200"
        },
        "updatedAt": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": "false"
        }
      }
    },
    "presence": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('friends').child($uid).child(auth.uid).exists())",
        ".write": "auth != null && auth.uid === $uid",
        "online": {
          ".validate": "newData.isBoolean()"
        },
        "lastSeen": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": "false"
        }
      }
    },
    "codes": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && !data.exists() && newData.val() === auth.uid",
        ".validate": "newData.isString() && $code.matches(/^[A-Z0-9]{6,12}$/)"
      }
    },
    "friends": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$friendUid": {
          ".write": "auth != null && (auth.uid === $uid || auth.uid === $friendUid) && (!newData.exists() || data.exists() || auth.uid === $uid && root.child('friendRequests').child($uid).child($friendUid).exists() || auth.uid === $friendUid && root.child('friendRequests').child($friendUid).child($uid).exists())",
          ".validate": "newData.hasChildren(['since'])",
          "since": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": "false"
          }
        }
      }
    },
    "friendRequests": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$fromUid": {
          ".write": "auth != null && $uid !== $fromUid && (auth.uid === $fromUid || (auth.uid === $uid && !newData.exists()))",
          "name": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          },
          "avatar": {
            ".validate": "newData.isString() && newData.val().length <= 200"
          },
          "code": {
            ".validate": "newData.isString() && newData.val().length <= 12"
          },
          "at": {
            ".validate": "newData.isNumber()"
          }
        }
      }
    },
    "invites": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$inviteId": {
          ".write": "auth != null && (auth.uid === $uid || (newData.child('fromUid').val() === auth.uid && root.child('friends').child($uid).child(auth.uid).exists()))",
          ".validate": "newData.child('fromUid').val() === auth.uid && newData.hasChild('gameId')",
          "gameId": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          },
          "gameType": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          },
          "fromName": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          },
          "fromAvatar": {
            ".validate": "newData.isString() && newData.val().length <= 200"
          },
          "at": {
            ".validate": "newData.isNumber()"
          }
        }
      }
    },
    "plays": {
      ".read": "auth != null",
      "$gameType": {
        "$mode": {
          ".write": "auth != null && $gameType.matches(/^[a-zA-Z0-9]{1,40}$/) && $mode.matches(/^[a-z]{1,20}$/)",
          ".validate": "newData.isNumber() && ((!data.exists() && newData.val() === 1) || (data.isNumber() && newData.val() === data.val() + 1))"
        }
      }
    },
    "playsDaily": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('admin').val() === true",
      "$day": {
        "$gameType": {
          "$mode": {
            "$counter": {
              ".write": "auth != null && $day.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/) && $gameType.matches(/^[a-zA-Z0-9]{1,40}$/) && ($mode === 'multi' || $mode === 'solo' || $mode === 'local') && ($counter === 'started' || $counter === 'finished' || $counter === 'abandoned')",
              ".validate": "newData.isNumber() && ((!data.exists() && newData.val() === 1) || (data.isNumber() && newData.val() === data.val() + 1))"
            }
          }
        }
      }
    },
    "results": {
      ".read": false,
      ".write": false
    },
    "leaderboard": {
      ".read": "auth != null",
      ".indexOn": [
        "wins",
        "verifiedWins"
      ],
      "$uid": {
        ".write": false
      }
    },
    "feedback": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('admin').val() === true",
      ".indexOn": [
        "createdAt"
      ],
      "$feedbackId": {
        ".write": "auth != null && ((!data.exists() && newData.child('by').val() === auth.uid && newData.parent().parent().child('users').child(auth.uid).child('lastFeedbackAt').val() === now && (!root.child('users').child(auth.uid).child('lastFeedbackAt').exists() || root.child('users').child(auth.uid).child('lastFeedbackAt').val() < now - 30000)) || root.child('users').child(auth.uid).child('admin').val() === true)",
        ".validate": "!newData.exists() || newData.hasChildren(['type','message','by','name','status','createdAt','updatedAt'])",
        "type": {
          ".validate": "newData.val() === 'bug' || newData.val() === 'feature' || newData.val() === 'report'"
        },
        "message": {
          ".validate": "newData.isString() && newData.val().length >= 10 && newData.val().length <= 1000"
        },
        "page": {
          ".validate": "newData.isString() && newData.val().length <= 300"
        },
        "by": {
          ".validate": "newData.val() === data.val() || (!data.exists() && newData.val() === auth.uid)"
        },
        "name": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "avatar": {
          ".validate": "newData.isString() && newData.val().length <= 160"
        },
        "status": {
          ".validate": "newData.val() === 'open' || newData.val() === 'planned' || newData.val() === 'done' || newData.val() === 'closed'"
        },
        "createdAt": {
          ".validate": "newData.isNumber()"
        },
        "updatedAt": {
          ".validate": "newData.isNumber()"
        },
        "gameId": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "targetUid": {
          ".validate": "newData.isString() && newData.val().length <= 128"
        },
        "targetName": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "text": {
          ".validate": "newData.isString() && newData.val().length <= 200"
        }
      }
    },
    "errors": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('admin').val() === true",
      "$day": {
        "$errorId": {
          ".write": "auth != null && !data.exists() && newData.exists() && $day.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)",
          ".validate": "newData.hasChildren(['at','kind','msg','route','build','ua','uid'])",
          "at": {
            ".validate": "newData.isNumber() && newData.val() <= now + 60000 && newData.val() >= now - 600000"
          },
          "kind": {
            ".validate": "newData.val() === 'error' || newData.val() === 'rejection' || newData.val() === 'boundary'"
          },
          "msg": {
            ".validate": "newData.isString() && newData.val().length <= 300"
          },
          "stack": {
            ".validate": "newData.isString() && newData.val().length <= 1500"
          },
          "route": {
            ".validate": "newData.isString() && newData.val().length <= 100"
          },
          "gameType": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          },
          "build": {
            ".validate": "newData.isString() && newData.val().length <= 20"
          },
          "ua": {
            ".validate": "newData.isString() && newData.val().length <= 60"
          },
          "uid": {
            ".validate": "newData.val() === auth.uid"
          },
          "$other": {
            ".validate": "false"
          }
        }
      }
    },
    "$other": {
      ".read": false,
      ".write": false
    }
  }
}
