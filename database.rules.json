{
  "rules": {
    "games": {
      ".indexOn": [
        "createdAt"
      ],
      "$gameId": {
        ".read": "auth != null",
        ".write": "auth != null && ((!data.exists() && newData.child('players').child('X').child('playerId').val() === auth.uid) || (data.child('visibility').val() !== 'public' && newData.child('visibility').val() !== 'public') || (data.child('visibility').val() === 'public' && (data.child('players').child('X').child('playerId').val() === auth.uid || data.child('players').child('O').child('playerId').val() === auth.uid || (!data.child('players').child('O').exists() && newData.child('players').child('O').child('playerId').val() === auth.uid))))",
        "players": {
          "$seat": {
            "playerId": {
              ".validate": "(!data.exists() && newData.val() === auth.uid) || newData.val() === data.val()"
            },
            "name": {
              ".validate": "newData.isString() && newData.val().length <= 40"
            }
          }
        },
        "chatLog": {
          "$msgId": {
            ".validate": "newData.val() === null || (newData.hasChildren(['by','name','text','ts']) && newData.child('text').isString() && newData.child('text').val().length >= 1 && newData.child('text').val().length <= 80 && newData.child('name').isString() && newData.child('name').val().length <= 40 && newData.child('by').val() === auth.uid && newData.child('ts').isNumber())"
          }
        },
        "visibility": {
          ".validate": "!newData.exists() || newData.val() === 'public' || newData.val() === 'private'"
        }
      }
    },
    "matchmaking": {
      ".read": "auth != null",
      ".indexOn": [
        "createdAt"
      ],
      "$gameId": {
        ".write": "auth != null && ((!data.exists() && root.child('games').child($gameId).child('visibility').val() === 'public' && root.child('games').child($gameId).child('status').val() === 'waiting' && root.child('games').child($gameId).child('players').child('X').child('playerId').val() === auth.uid && newData.child('hostUid').val() === auth.uid) || (data.exists() && data.child('hostUid').val() === auth.uid) || (!newData.exists() && root.child('games').child($gameId).child('players').child('O').child('playerId').val() === auth.uid))",
        ".validate": "!newData.exists() || (newData.hasChildren(['gameId','gameType','visibility','hostUid','hostName','createdAt','expiresAt']) && newData.child('gameId').val() === $gameId && newData.child('visibility').val() === 'public' && newData.child('hostUid').val() === root.child('games').child($gameId).child('players').child('X').child('playerId').val() && newData.child('hostName').isString() && newData.child('hostName').val().length <= 40 && newData.child('createdAt').isNumber() && newData.child('expiresAt').isNumber())"
      }
    },
    "users": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid && ((!data.child('admin').exists() && !newData.child('admin').exists()) || newData.child('admin').val() === data.child('admin').val())",
        "displayName": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "admin": {
          ".validate": "newData.isBoolean()"
        }
      }
    },
    "codes": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && !data.exists() && newData.val() === auth.uid"
      }
    },
    "friends": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$friendUid": {
          ".write": "auth != null && (auth.uid === $uid || auth.uid === $friendUid)",
          ".validate": "newData.hasChild('since') || !newData.exists()"
        }
      }
    },
    "friendRequests": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$fromUid": {
          ".write": "auth != null && (auth.uid === $fromUid || auth.uid === $uid)",
          ".validate": "!newData.exists() || !newData.hasChild('name') || (newData.child('name').isString() && newData.child('name').val().length <= 40)"
        }
      }
    },
    "plays": {
      ".read": "auth != null",
      "$gameType": {
        "$mode": {
          ".write": "auth != null",
          ".validate": "newData.isNumber()"
        }
      }
    },
    "leaderboard": {
      ".read": "auth != null",
      ".indexOn": [
        "wins"
      ],
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['name','wins','games'])",
        "name": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "wins": {
          ".validate": "newData.isNumber()"
        },
        "games": {
          ".validate": "newData.isNumber()"
        },
        "bestStreak": {
          ".validate": "newData.isNumber()"
        },
        "avatar": {
          ".validate": "newData.isString()"
        },
        "updatedAt": {
          ".validate": "newData.isNumber()"
        }
      }
    },
    "invites": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$inviteId": {
          ".write": "auth != null && (auth.uid === $uid || (newData.child('fromUid').val() === auth.uid && root.child('friends').child($uid).child(auth.uid).exists()))",
          ".validate": "!newData.exists() || (newData.child('fromUid').val() === auth.uid && newData.hasChild('gameId'))"
        }
      }
    },
    "feedback": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('admin').val() === true",
      ".indexOn": [
        "createdAt"
      ],
      "$feedbackId": {
        ".write": "auth != null && ((!data.exists() && newData.child('by').val() === auth.uid) || root.child('users').child(auth.uid).child('admin').val() === true)",
        ".validate": "!newData.exists() || newData.hasChildren(['type','message','by','name','status','createdAt','updatedAt'])",
        "type": {
          ".validate": "newData.val() === 'bug' || newData.val() === 'feature'"
        },
        "message": {
          ".validate": "newData.isString() && newData.val().length >= 10 && newData.val().length <= 1000"
        },
        "page": {
          ".validate": "newData.isString() && newData.val().length <= 300"
        },
        "by": {
          ".validate": "newData.val() === data.val() || (!data.exists() && newData.val() === auth.uid)"
        },
        "name": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "avatar": {
          ".validate": "newData.isString() && newData.val().length <= 160"
        },
        "status": {
          ".validate": "newData.val() === 'open' || newData.val() === 'planned' || newData.val() === 'done' || newData.val() === 'closed'"
        },
        "createdAt": {
          ".validate": "newData.isNumber()"
        },
        "updatedAt": {
          ".validate": "newData.isNumber()"
        }
      }
    },
    "$other": {
      ".read": false,
      ".write": false
    }
  }
}
