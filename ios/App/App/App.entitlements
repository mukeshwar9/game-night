<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Push Notifications; Xcode switches it to production for distribution. -->
	<key>aps-environment</key>
	<string>development</string>
	<!-- Universal Links for invite links. Add applinks:<custom domain> when it is live. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:game-night-91464.web.app</string>
	</array>
	<!-- Sign in with Apple (App Store guideline 4.8). -->
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
</dict>
</plist>
