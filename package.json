{
  "name": "games-platform",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:emu": "vite --mode emulator",
    "art:pixel": "node scripts/pixel-art/build.mjs",
    "build": "vite build",
    "native:bump": "node scripts/bump-native-version.mjs",
    "rules:media": "node scripts/rule-media.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -p jsconfig.json --noEmit",
    "emulators": "firebase emulators:start --only auth,database --project demo-game-night",
    "test:rules": "node scripts/with-emulators.mjs database npx vitest run --config vitest.rules.config.js",
    "test:e2e": "node scripts/with-emulators.mjs auth,database npx playwright test",
    "deploy": "node scripts/deploy.mjs",
    "symbolicate": "node scripts/symbolicate.mjs",
    "sourcemaps:sentry": "node scripts/upload-sourcemaps.mjs"
  },
  "dependencies": {
    "@capacitor-firebase/authentication": "^8.5.2",
    "@capacitor-firebase/messaging": "^8.5.2",
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/text-zoom": "^8.0.1",
    "@sentry/capacitor": "4.4.0",
    "@sentry/react": "10.69.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "firebase": "^12.14.0",
    "framer-motion": "^13.2.0",
    "posthog-js": "^1.438.2",
    "qrcode": "^1.5.4",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.18.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@jridgewell/trace-mapping": "^0.3.31",
    "@playwright/test": "^1.63.0",
    "@sentry/cli": "^3.8.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^8.0.12",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11",
    "workbox-window": "^7.4.1"
  }
}
